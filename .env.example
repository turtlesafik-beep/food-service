# Скопируйте в .env и поменяйте пароль перед публикацией.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Telegram-уведомления и ссылки в сообщениях.
# Публичный адрес сайта без завершающего слэша. Используется в ссылках на заказ.
# PUBLIC_BASE_URL=https://food.example.com

# Telegram-уведомления. Токен не коммитить в Git.
# TELEGRAM_BOT_TOKEN=
# Разрешённые числовые Telegram user_id через запятую (username не используется).
# TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# Резервное копирование (необязательно).
# BACKUP_MAX_BYTES=536870912
# TMP_DIR=data/tmp
